generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AlbumMemberRole {
  OWNER
  MEMBER
}

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  albumMembers AlbumMember[]
  stickers     UserSticker[]
  albumVisits  AlbumVisitor[]
  tradeRequestsSent     TradeRequest[] @relation("TradeRequester")
  tradeRequestsReceived TradeRequest[] @relation("TradeTarget")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Album {
  id                   String   @id @default(cuid())
  name                 String
  inviteToken          String   @unique @default(cuid())
  inviteRevoked        Boolean  @default(false)
  ownerInviteCode      String?  @unique
  ownerInviteRevoked   Boolean  @default(false)
  isPublic             Boolean  @default(true)
  viewCount            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members       AlbumMember[]
  visitors      AlbumVisitor[]
  tradeRequests TradeRequest[]
}

model AlbumMember {
  id       String          @id @default(cuid())
  albumId  String
  userId   String
  role     AlbumMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@index([userId])
}

model AlbumVisitor {
  id             String   @id @default(cuid())
  albumId        String
  userId         String
  visitCount     Int      @default(1)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt  DateTime @updatedAt

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([albumId, userId])
  @@index([userId, lastVisitedAt])
  @@index([albumId, lastVisitedAt])
}

model UserSticker {
  id             String  @id @default(cuid())
  userId         String
  stickerNumber  Int
  owned          Boolean @default(false)
  duplicateCount Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stickerNumber])
  @@index([userId, duplicateCount])
}

model TradeRequest {
  id            String      @id @default(cuid())
  albumId       String
  requesterId   String
  targetUserId  String
  stickerNumber Int
  quantity      Int         @default(1)
  message       String?
  status        TradeStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  album     Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  requester User  @relation("TradeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User  @relation("TradeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([albumId])
  @@index([requesterId])
  @@index([targetUserId])
  @@index([status])
}
